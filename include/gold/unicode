    /// validate_utf_sequence
    template <__uc::utf_range R>
    constexpr uc::transcoding_state validate_utf_sequence(R&& r) {
        auto utf_seq = to_utf32(r);
        uc::transcoding_error err = uc::transcoding_error::none;
        auto iter = utf_seq.begin();
        auto sent = utf_seq.end();
        for (; iter != sent; ++iter) {
            if (iter.error()) {
                err = iter.error();
                break;
            }
        }
        return {err};
    }

