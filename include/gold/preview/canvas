    /// canvas::basic_position
    template <typename T>
    struct basic_position {
        using value_type = T;

        T x;
        T y;

        friend constexpr bool operator==(basic_position, basic_position) noexcept = default;
        friend constexpr std::strong_ordering operator<=>(basic_position, basic_position) noexcept = default;
    };

    /// canvas::position
    using position = basic_position <std::size_t>;

    /// canvas::basic_size
    template <typename T>
    struct basic_size {
        using value_type = T;

        T width;
        T height;

        friend constexpr bool operator==(basic_size, basic_size) noexcept = default;
        friend constexpr std::strong_ordering operator<=>(basic_size, basic_size) noexcept = default;
    };

    /// canvas::size
    using size = basic_size <std::size_t>;

    /// canvas::basic_region
    template <typename T>
    struct basic_region {
        using value_type    = T;
        using position_type = basic_position<T>;
        using size_type     = basic_size<T>;

        // base position is at top-left
        basic_position<T> base_position;
        basic_size<T> size;

        constexpr bool empty() const noexcept {
            return size.width == 0 || size.height == 0;
        }

        constexpr explicit operator bool() const noexcept {
            return !empty();
        }

        // temporary names
        constexpr basic_position<T> top_left_position() const noexcept
        { return {.x = base_position.x, .y = base_position.y}; }
        constexpr basic_position<T> top_right_position() const noexcept
        { return {.x = base_position.x + size.width, .y = base_position.y}; }
        constexpr basic_position<T> bottom_left_position() const noexcept
        { return {.x = base_position.x, .y = base_position.y + size.height}; }
        constexpr basic_position<T> bottom_right_position() const noexcept
        { return {.x = base_position.x + size.width, .y = base_position.y + size.height}; }

        constexpr auto corners() const noexcept {
            struct return_type {
                T top;    // y-component top-left
                T left;   // x-component top-left
                T bottom; // y-component bottom-right
                T right;  // x-component bottom-right
            };
            const auto [left, top]     = top_left_position();
            const auto [right, bottom] = bottom_right_position();
            return return_type {
                .top    = top,
                .left   = left,
                .bottom = bottom,
                .right  = right
            };
        }

        constexpr bool contains(basic_position<T> pos) const noexcept {
            const auto [top, left, bottom, right] = corners();
            return left <= pos.x && pos.x <= right &&
                   top  <= pos.y && pos.y <= bottom;
        }

        constexpr basic_region<T> intersection_with(basic_region<T> other) const noexcept {
            // TODO: validate

            const auto [top, left, bottom, right] = corners();
            const auto [other_top, other_left, other_bottom, other_right] = other.corners();

            if (left >= other_right ||
                other_left >= right ||
                top >= other_bottom ||
                other_top >= bottom)
                return {};

            const auto common_left   = __algo::max_element({left, other_left});
            const auto common_top    = __algo::max_element({top, other_top});
            const auto common_right  = __algo::min_element({right, other_right});
            const auto common_bottom = __algo::min_element({bottom, other_bottom});

            return {
                .base_position {
                    .x = common_left,
                    .y = common_top,
                },
                .size {
                    .width = common_right - common_left,
                    .height = common_bottom - common_top,
                }
            };
        }

        constexpr bool intersects_with(basic_region<T> other) const noexcept
        { return !intersection_with(other).empty(); }

        friend constexpr bool operator==(basic_region, basic_region) noexcept = default;
    };

    /// canvas::region
    using region = basic_region <std::size_t>;

    /// canvas::angle
    struct angle {
        using storage_type = double;

        double radians;

        static constexpr angle from_radians(double val) {
            return angle {val};
        }

        static constexpr angle from_degrees(double val) {
            return angle {val / 180.0 * std::numbers::pi};
        }

        constexpr double to_radians() const noexcept {
            return radians;
        }

        constexpr double to_degrees() const noexcept {
            return radians * 180.0 / std::numbers::pi;
        }

        constexpr angle normalized() const noexcept {
            double new_val = __builtin_fmod(radians, std::numbers::pi * 2);
            if (new_val < 0)
                new_val += std::numbers::pi * 2;
            return angle {new_val};
        }
    };

