        /// __canvas::lower_case_view
        struct lower_case_view {
            std::string_view base;

            struct iterator {
                using iterator_concept = std::input_iterator_tag;
                using value_type = char;
                using difference_type = std::size_t;

                std::string_view::iterator iter;

                constexpr char operator*() const noexcept {
                    return __builtin_tolower(*iter);
                }

                constexpr iterator& operator++() noexcept {
                    ++iter;
                    return *this;
                }

                constexpr iterator operator++(int) noexcept {
                    auto self = *this;
                    ++*this;
                    return self;
                }

                constexpr bool operator==(const iterator& other) const noexcept = default;

                constexpr bool operator==(std::string_view::iterator other) const noexcept {
                    return iter == other;
                }

            };

            constexpr auto begin() const noexcept {
                return iterator { base.begin() };
            }

            constexpr auto end() const noexcept {
                return iterator { base.end() };
            }

            constexpr std::size_t size() const noexcept {
                return base.size();
            }

            constexpr bool operator==(std::string_view other) const noexcept {
                if (base.size() != other.size())
                    return false;
                auto iter1 = begin();
                auto sent1 = end();
                auto iter2 = other.begin();
                auto sent2 = other.end();
                for (; iter1 != sent1 && sent1 != sent2; ++iter1, ++iter2) {
                    if (*iter1 != *iter2)
                        return false;
                }
                return true;
            }
        };

