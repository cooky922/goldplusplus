        constexpr image_view(image& m) noexcept
        : m_pixels_(m.m_pixels_), m_width_(m.m_width_), m_height_(m.m_height_) {}

        /// from_bytes
        static constexpr image_view from_bytes(std::span<std::byte> bytes, std::size_t width, std::size_t height) {
            image_view result;
            result.m_pixels_ = bytes;
            result.m_width_ = width;
            result.m_height_ = height;
            return result;
        }

