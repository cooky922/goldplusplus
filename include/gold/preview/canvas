    /// canvas::basic_color_rgb
    // concrete color with alpha = 255
    template <typename T>
    struct basic_color_rgb {
        using channel_storage_type = T;

        T red;
        T green;
        T blue;

        static constexpr bool is_fully_opaque() noexcept { return true; }
        static constexpr bool is_fully_transparent() noexcept { return false; }

        constexpr bool is_ok() const noexcept {
            if constexpr (__is_same(T, gold::uint8_t))
                return true;
            else if constexpr (std::is_unsigned_v<T> && std::is_integral_v<T>)
                return red   <= 255 &&
                       green <= 255 &&
                       blue  <= 255;
            else if constexpr (sizeof(T) > 1 && std::is_signed_v<T> && std::is_integral_v<T>)
                return 0 <= red   && red   <= 255 &&
                       0 <= green && green <= 255 &&
                       0 <= blue  && blue  <= 255;
            else if constexpr (std::is_floating_point_v<T>)
                return 0.0 <= red   && red   <= 1.0 &&
                       0.0 <= green && green <= 1.0 &&
                       0.0 <= blue  && blue  <= 1.0;
            else
                return false;
        }

        /// operator==
        constexpr bool operator==(const basic_color_rgb&) const noexcept = default;
    };

    /// canvas::color_rgb
    using color_rgb = basic_color_rgb<gold::uint8_t>;

    /// canvas::color_rgb_float
    using color_rgb_float = basic_color_rgb<float>;

    /// canvas::color_rgb_unit
    // synonymous to canvas::color_rgb_float
    // where the numbers are normalized into [0, 1]
    using color_rgb_unit = basic_color_rgb<float>;

    /// canvas::basic_color_rgba
    template <typename T>
    struct basic_color_rgba {
        using channel_storage_type = T;

        T red;
        T green;
        T blue;
        T alpha;

        constexpr bool is_fully_opaque() const noexcept {
            if constexpr (std::is_floating_point_v<T>)
                return alpha == 1.0;
            else
                return alpha == 255;
        }

        constexpr bool is_fully_transparent() const noexcept { return alpha == 0; }

        constexpr bool is_ok() const noexcept {
            if constexpr (__is_same(T, gold::uint8_t))
                return true;
            else if constexpr (std::is_unsigned_v<T> && std::is_integral_v<T>)
                return red   <= 255 &&
                       green <= 255 &&
                       blue  <= 255 &&
                       alpha <= 255;
            else if constexpr (sizeof(T) > 1 && std::is_signed_v<T> && std::is_integral_v<T>)
                return 0 <= red   && red   <= 255 &&
                       0 <= green && green <= 255 &&
                       0 <= blue  && blue  <= 255 &&
                       0 <= alpha && alpha <= 255;
            else if constexpr (std::is_floating_point_v<T>)
                return 0.0 <= red   && red   <= 1.0 &&
                       0.0 <= green && green <= 1.0 &&
                       0.0 <= blue  && blue  <= 1.0 &&
                       0.0 <= alpha && alpha <= 1.0;
            else
                return false;
        }

        /// operator==
        constexpr bool operator==(const basic_color_rgba&) const noexcept = default;
    };

    /// canvas::color_rgba
    using color_rgba = basic_color_rgba<gold::uint8_t>;

    /// canvas::color_rgba_float
    using color_rgba_float = basic_color_rgba<float>;

    /// canvas::color_rgba_unit
    using color_rgba_unit = basic_color_rgba<float>;

    /// canvas::color_hsl
    struct color_hsl {
        // degree
        gold::uint16_t hue;         // 0 - 360

        // percentage
        gold::uint8_t  saturation;  // 0 - 100
        gold::uint8_t  lightness;   // 0 - 100

        static consteval bool is_fully_opaque() { return true; }
        static consteval bool is_fully_transparent() { return false; }

        constexpr bool is_ok() const noexcept {
            return hue        <  360 &&
                   saturation <= 100 &&
                   lightness  <= 100;
        }

        /// operator==
        constexpr bool operator==(const color_hsl&) const noexcept = default;
    };

    /// canvas::color_cmyk
    struct color_cmyk {
        float cyan;
        float magenta;
        float yellow;
        float black_key;

        static consteval bool is_fully_opaque() { return true; }
        static consteval bool is_fully_transparent() { return false; }

        constexpr bool is_ok() const noexcept {
            return 0.0f <= cyan      && cyan      <= 1.0f
                && 0.0f <= magenta   && magenta   <= 1.0f
                && 0.0f <= yellow    && yellow    <= 1.0f
                && 0.0f <= black_key && black_key <= 1.0f;
        }

        /// operator==
        constexpr bool operator==(const color_cmyk&) const noexcept = default;
    };

    /// canvas::color
    class color {
      private:
        // canvas::color internally stores a value
        // representing hexadecimal value of a color

        // here is the sequence of bytes regardless of the endianness:
        // 1st byte -> red channel
        // 2nd byte -> green channel
        // 3rd byte -> blue channel
        // 4th byte -> alpha channel

        gold::uint32_t m_color_hex_;

      public:
        constexpr color() noexcept = default;

        /// from_hex (canvas::color_hex)
        static constexpr color from_hex(canvas::color_hex arg) noexcept {
            gold::uint32_t underlying_code = static_cast<gold::uint32_t>(arg);
            underlying_code <<= 8;
            underlying_code  |= 0xff;

            color result;
            if constexpr (std::endian::native == std::endian::little)
                result.m_color_hex_ = __builtin_bswap32(underlying_code);
            else
                result.m_color_hex_ = underlying_code;

            return result;
        }

        /// from_hex (canvas::color_hex_with_alpha)
        static constexpr color from_hex(canvas::color_hex_with_alpha arg) noexcept {
            color result;
            if constexpr (std::endian::native == std::endian::little)
                result.m_color_hex_ = __builtin_bswap32(static_cast<gold::uint32_t>(arg));
            else
                result.m_color_hex_ = arg;
            return result;
        }

        /// from_rgb
        static constexpr color from_rgb(canvas::color_rgb arg) noexcept {
            return from_hex(canvas::color_hex(
                ((arg.red   & 0xff) << 16) |
                ((arg.green & 0xff) << 8)  |
                 (arg.blue  & 0xff)
            ));
        }

        static constexpr color from_rgb(gold::uint8_t r, gold::uint8_t g, gold::uint8_t b) noexcept {
            return from_rgb(canvas::color_rgb(r, g, b));
        }

        /// from_rgb_unit
        static constexpr color from_rgb_unit(canvas::color_rgb_unit arg) noexcept {
            return from_rgb(canvas::color_rgb{
                .red   = static_cast<gold::uint8_t>(arg.red * 255),
                .green = static_cast<gold::uint8_t>(arg.green * 255),
                .blue  = static_cast<gold::uint8_t>(arg.blue * 255)
            });
        }

        /// from_rgba
        static constexpr color from_rgba(canvas::color_rgba arg) noexcept {
            return from_hex(canvas::color_hex_with_alpha(
                ((arg.red   & 0xff) << 24) |
                ((arg.green & 0xff) << 16) |
                ((arg.blue  & 0xff) << 8)  |
                 (arg.alpha & 0xff)
            ));
        }

        static constexpr color from_rgba(gold::uint8_t r, gold::uint8_t g, gold::uint8_t b, gold::uint8_t a) noexcept {
            return from_rgba(canvas::color_rgba(r, g, b, a));
        }

        /// from_rgba_unit
        static constexpr color from_rgba_unit(canvas::color_rgba_unit arg) noexcept {
            return from_rgba(canvas::color_rgba{
                .red   = static_cast<gold::uint8_t>(arg.red   * 255),
                .green = static_cast<gold::uint8_t>(arg.green * 255),
                .blue  = static_cast<gold::uint8_t>(arg.blue  * 255),
                .alpha = static_cast<gold::uint8_t>(arg.alpha * 255)
            });
        }

        /// from_hsl
        static constexpr color from_hsl(canvas::color_hsl arg) noexcept {
            // TODO: optimize
            const double normalized_saturation = double (arg.saturation) / 100.0;
            const double normalized_lightness  = double (arg.lightness)  / 100.0;
            const double c = (1 - __builtin_fabs(2 * normalized_lightness - 1)) * normalized_saturation;
            const double x = c * (1 - __builtin_fabs(__builtin_fmod(double(arg.hue) / 60, 2) - 1));
            const double m = normalized_lightness - c / 2;
            const auto [prime_red, prime_green, prime_blue] = [&, hue = arg.hue] {
                struct return_type { double r, g, b; };
                if (hue < 60)
                    return return_type { c, x, 0 };
                else if (60 <= hue && hue < 120)
                    return return_type { x, c, 0 };
                else if (120 <= hue && hue < 180)
                    return return_type { 0, c, x };
                else if (180 <= hue && hue < 240)
                    return return_type { 0, x, c };
                else if (240 <= hue && hue < 300)
                    return return_type { x, 0, c };
                else
                    return return_type { c, 0, x };
            }();
            return from_rgb_unit({
                .red   = static_cast<float>(prime_red + m),
                .green = static_cast<float>(prime_green + m),
                .blue  = static_cast<float>(prime_blue + m)
            });
        }

        /// from_cmyk
        static constexpr color from_cmyk(canvas::color_cmyk arg) noexcept {
            return from_rgb({
                .red   = gold::uint8_t(255 * (1 - arg.cyan)    * (1 - arg.black_key)),
                .green = gold::uint8_t(255 * (1 - arg.magenta) * (1 - arg.black_key)),
                .blue  = gold::uint8_t(255 * (1 - arg.yellow)  * (1 - arg.black_key))
            });
        }

        /// extract_red
        constexpr gold::uint8_t extract_red() const noexcept {
            if constexpr (std::endian::native == std::endian::little)
                return m_color_hex_ & 0xff;
            else
                return (m_color_hex_ >> 24) & 0xff;
        }

        /// extract_green
        constexpr gold::uint8_t extract_green() const noexcept {
            if constexpr (std::endian::native == std::endian::little)
                return (m_color_hex_ >> 8) & 0xff;
            else
                return (m_color_hex_ >> 16) & 0xff;
        }

        /// extract_blue
        constexpr gold::uint8_t extract_blue() const noexcept {
            if constexpr (std::endian::native == std::endian::little)
                return (m_color_hex_ >> 16) & 0xff;
            else
                return (m_color_hex_ >> 8) & 0xff;
        }

        /// extract_alpha
        constexpr gold::uint8_t extract_alpha() const noexcept {
            if constexpr (std::endian::native == std::endian::little)
                return (m_color_hex_ >> 24) & 0xff;
            else
                return m_color_hex_ & 0xff;
        }

        /// set_red
        constexpr color& set_red(gold::uint8_t c) noexcept {
            // TODO: optimize
            color_rgba rgba = to_rgba();
            rgba.red = c;
            return *this = from_rgba(rgba);
        }

        /// set_green
        constexpr color& set_green(gold::uint8_t c) noexcept {
            color_rgba rgba = to_rgba();
            rgba.green = c;
            return *this = from_rgba(rgba);
        }

        /// set_blue
        constexpr color& set_blue(gold::uint8_t c) noexcept {
            // TODO: optimize
            color_rgba rgba = to_rgba();
            rgba.blue = c;
            return *this = from_rgba(rgba);
        }

        /// set_alpha
        constexpr color& set_alpha(gold::uint8_t c) noexcept {
            // TODO: optimize
            color_rgba rgba = to_rgba();
            rgba.alpha = c;
            return *this = from_rgba(rgba);
        }

        /// with_alpha
        // different from 'set_alpha'
        // can be used in both mutable and constant object
        // but it returns a new object regardless of its immutability
        constexpr color with_alpha(gold::uint8_t c) const noexcept {
            // TODO: optimize
            color_rgba rgba = to_rgba();
            rgba.alpha = c;
            return from_rgba(rgba);
        }

        /// is_fully_opaque
        constexpr bool is_fully_opaque() const noexcept {
            return extract_alpha() == 255;
        }

        /// is_fully_transparent
        constexpr bool is_fully_transparent() const noexcept {
            return extract_alpha() == 0;
        }

        /// alpha_blended_on
        constexpr color alpha_blended_on(canvas::color other) const noexcept {
            // normalize alpha
            const double alpha = double(extract_alpha()) / 255.0;
            const double on_alpha = double(other.extract_alpha()) / 255.0;
            const double new_alpha = alpha + on_alpha * (1 - alpha);
            const auto [this_red, this_green, this_blue] = to_rgb();
            const auto [other_red, other_green, other_blue] = other.to_rgb();

            return from_rgba({
                .red   = gold::uint8_t(alpha * this_red   + (1.0 - alpha) * other_red),
                .green = gold::uint8_t(alpha * this_green + (1.0 - alpha) * other_green),
                .blue  = gold::uint8_t(alpha * this_blue  + (1.0 - alpha) * other_blue),
                .alpha = gold::uint8_t(new_alpha * 255)
            });
        }

        /// alpha_blend_on
        constexpr color& alpha_blend_on(canvas::color other) noexcept {
            return *this = alpha_blended_on(other);
        }

        /// to_hex
        constexpr color_hex to_hex() const noexcept {
            return color_hex(to_hex_with_alpha() >> 8);
        }

        /// to_hex_with_alpha
        constexpr color_hex_with_alpha to_hex_with_alpha() const noexcept {
            if constexpr (std::endian::native == std::endian::little)
                return color_hex_with_alpha(__builtin_bswap32(m_color_hex_));
            else
                return color_hex_with_alpha(m_color_hex_);
        }

        /// to_rgb
        constexpr color_rgb to_rgb() const noexcept {
            const auto [r, g, b, _] = to_rgba();
            return color_rgb { r, g, b };
        }

        /// to_rgba
        constexpr color_rgba to_rgba() const noexcept {
            return std::bit_cast<color_rgba>(m_color_hex_);
        }

        /// to_hsl
        constexpr color_hsl to_hsl() const noexcept {
            const auto [red, green, blue] = to_rgb();

            const double normalized_red = double(red) / 255.0;
            const double normalized_green = double(green) / 255.0;
            const double normalized_blue = double(blue) / 255.0;

            const auto [c_min, c_max] = __algo::min_max_element({red, green, blue});
            const double normalized_c_min = double(c_min) / 255.0;
            const double normalized_c_max = double(c_max) / 255.0;

            const auto delta = c_max - c_min;
            const double normalized_delta = normalized_c_max - normalized_c_min;

            const gold::uint16_t hue = [&] -> gold::uint16_t {
                if (delta == 0)
                    return 0;
                else if (c_max == red)
                    return gold::uint16_t(60 * (__builtin_fmod((normalized_green - normalized_blue) / normalized_delta, 6)));
                else if (c_max == green)
                    return gold::uint16_t(60 * (((normalized_blue - normalized_red) / normalized_delta) + 2));
                else if (c_max == blue)
                    return gold::uint16_t(60 * (((normalized_red - normalized_green) / normalized_delta) + 4));
            }();
            const gold::uint8_t saturation = [&] -> gold::uint8_t {
                if (delta == 0)
                    return 0;
                else
                    return gold::uint8_t(100 * (normalized_delta / (1 - __builtin_fabs(normalized_c_max + normalized_c_min - 1))));
            }();
            const gold::uint8_t lightness = (c_max + c_min) / 2;

            return color_hsl { hue, saturation, lightness };
        }

        /// to_cmyk
        constexpr color_cmyk to_cmyk() const noexcept {
            const auto [red, green, blue] = to_rgb();

            const auto max_c = __algo::max_element({red, green, blue});

            const double normalized_red = double(red) / 255.0;
            const double normalized_green = double(green) / 255.0;
            const double normalized_blue = double(blue) / 255.0;
            const double normalized_max = double(max_c) / 255.0;

            const double k = 1 - normalized_max;
            const double c = (1 - normalized_red - k) / (1 - k);
            const double m = (1 - normalized_green - k) / (1 - k);
            const double y = (1 - normalized_blue - k) / (1 - k);

            return color_cmyk {
                .cyan      = float(c),
                .magenta   = float(m),
                .yellow    = float(y),
                .black_key = float(k)
            };
        }

