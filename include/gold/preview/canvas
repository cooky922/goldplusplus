    /// canvas::image
    class image {
      private:
        std::vector<std::byte> m_pixels_;
        std::size_t m_width_;
        std::size_t m_height_;

        friend class image_view;

        constexpr auto mf_as_mdview_bytes_() noexcept {
            using Extents = std::extents<std::size_t, std::dynamic_extent, std::dynamic_extent, 4>;
            return std::mdspan<std::byte, Extents>(m_pixels_.data(), m_height_, m_width_);
        }

        constexpr auto mf_as_mdview_bytes_() const noexcept {
            using Extents = std::extents<std::size_t, std::dynamic_extent, std::dynamic_extent, 4>;
            return std::mdspan<const std::byte, Extents>(m_pixels_.data(), m_height_, m_width_);
        }

        auto mf_as_mdview_colors_() noexcept {
            using Extents = std::extents<std::size_t, std::dynamic_extent, std::dynamic_extent>;
            return std::mdspan<canvas::color, Extents>(
                reinterpret_cast<canvas::color*>(m_pixels_.data()), m_height_, m_width_
            );
        }

        auto mf_as_mdview_colors_() const noexcept {
            using Extents = std::extents<std::size_t, std::dynamic_extent, std::dynamic_extent>;
            return std::mdspan<const canvas::color, Extents>(
                reinterpret_cast<const canvas::color*>(m_pixels_.data()), m_height_, m_width_
            );
        }

      public:
        /// create
        static constexpr image create (canvas::size dimension, canvas::color c) noexcept {
            if (dimension.width && dimension.height) {
                image result;
                result.m_width_ = dimension.width;
                result.m_height_ = dimension.height;

                result.m_pixels_.resize(result.m_width_ * result.m_height_ * 4);

                if consteval {
                    std::byte* iter = result.m_pixels_.data();
                    std::byte* sent = iter + result.m_pixels_.size();

                    const auto red_channel   = std::byte{c.extract_red()};
                    const auto green_channel = std::byte{c.extract_green()};
                    const auto blue_channel  = std::byte{c.extract_blue()};
                    const auto alpha_channel = std::byte{c.extract_alpha()};

                    while (iter != sent) {
                        *iter++ = red_channel;
                        *iter++ = green_channel;
                        *iter++ = blue_channel;
                        *iter++ = alpha_channel;
                    }
                } else {
                    canvas::color* iter = reinterpret_cast<canvas::color*>(result.m_pixels_.data());
                    canvas::color* sent = iter + result.m_pixels_.size() / 4;

                    while (iter != sent)
                        *iter++ = c;
                }

                return result;
            }
            return {};
        }

        /// try_load_from_file
        static gold::expected<image, std::string_view> try_load_from_file (std::string_view filename) noexcept {

            // pre: filename.end() == '\0'

            image result;

            int width = 0;
            int height = 0;
            int channels = 0;

            unsigned char* ptr = ::stbi_load(filename.data(), &width, &height, &channels, STBI_rgb_alpha);

            if (ptr) {
                result.m_width_ = static_cast<std::size_t>(width);
                result.m_height_ = static_cast<std::size_t>(height);

                if (result.m_width_ > 0 && result.m_height_ > 0) {
                    result.m_pixels_.resize(static_cast<std::size_t>(width * height * 4));
                    __builtin_memcpy(result.m_pixels_.data(), ptr, result.m_pixels_.size());
                }

                ::stbi_image_free(ptr);

            } else {
                // TODO:
                return gold::unexpected<std::string_view>(::stbi_failure_reason());
            }

            return std::move(result);
        }

        /// try_load_from_memory
        static gold::expected<image, std::string_view> try_load_from_memory (std::span <const std::byte> buffer) noexcept {

            if (buffer.empty())
                return gold::unexpected<std::string_view>("error: loading from empty buffer");

            image result;

            int width = 0;
            int height = 0;
            int channels = 0;

            const unsigned char* transmuted_buffer = reinterpret_cast<const unsigned char*>(buffer.data());

            unsigned char* ptr = ::stbi_load_from_memory(transmuted_buffer, buffer.size_bytes(), &width, &height, &channels, STBI_rgb_alpha);

            if (ptr) {
                result.m_width_ = static_cast<std::size_t>(width);
                result.m_height_ = static_cast<std::size_t>(height);

                if (result.m_width_ > 0 && result.m_height_ > 0) {
                    result.m_pixels_.resize(static_cast<std::size_t>(width * height * 4));
                    __builtin_memcpy(result.m_pixels_.data(), ptr, result.m_pixels_.size());
                }

                ::stbi_image_free(ptr);

            } else {
                // TODO:
                return gold::unexpected<std::string_view>(::stbi_failure_reason());
            }

            return std::move(result);
        }

        /// try_save_as
        gold::expected<void, std::string_view> try_save_as(std::string_view filename) const noexcept {
            if (!m_pixels_.empty() && m_width_ > 0 && m_height_ > 0) {

                const std::size_t dot_at = filename.find_last_of('.');
                const auto extension = __canvas::lower_case_view{dot_at != std::string_view::npos ? filename.substr(dot_at + 1) : ""};

                const int c_width = static_cast<int>(m_width_);
                const int c_height = static_cast<int>(m_height_);

                if (extension == "bmp") {
                    if (::stbi_write_bmp(filename.data(), c_width, c_height, 4, m_pixels_.data()))
                        return {};
                } else if (extension == "tga") {
                    if (::stbi_write_tga(filename.data(), c_width, c_height, 4, m_pixels_.data()))
                        return {};
                } else if (extension == "png") {
                    if (::stbi_write_png(filename.data(), c_width, c_height, 4, m_pixels_.data(), 0))
                        return {};
                } else if (extension == "jpg" || extension == "jpeg") {
                    if (::stbi_write_jpg(filename.data(), c_width, c_height, 4, m_pixels_.data(), 90))
                        return {};
                }
            }

            return gold::unexpected<std::string_view>("error: unable to save image");
        }

        /// size
        constexpr canvas::size size() const noexcept {
            return canvas::size { m_width_, m_height_ };
        }

        /// as_canvas_view
        canvas::canvas_view as_canvas_view() noexcept {
            return mf_as_mdview_colors_();
        }

        /// as_canvas_view
        canvas::const_canvas_view as_canvas_view() const noexcept {
            return mf_as_mdview_colors_();
        }

        /// get_pixel
        // represented by color
        constexpr canvas::color get_pixel(canvas::position pos) const noexcept {
            // TODO: replace with gold::mdspan operations + SIMD
            const std::byte* pixel_ptr = &m_pixels_[(pos.x + pos.y * m_width_) * 4];
            if consteval {
                return canvas::color::from_rgba({
                    std::to_integer<gold::uint8_t>(pixel_ptr[0]),
                    std::to_integer<gold::uint8_t>(pixel_ptr[1]),
                    std::to_integer<gold::uint8_t>(pixel_ptr[2]),
                    std::to_integer<gold::uint8_t>(pixel_ptr[3])
                });
            } else {
                return *reinterpret_cast<const canvas::color*>(pixel_ptr);
            }
        }

        /// set_pixel
        constexpr void set_pixel(canvas::position pos, canvas::color new_color) noexcept {
            // TODO: replace with gold::mdspan operations + SIMD
            if (m_pixels_.empty())
                return;
            if consteval {
                std::byte* pixel_ptr = &m_pixels_[(pos.x + pos.y * m_width_) * 4];
                pixel_ptr[0] = std::byte { new_color.extract_red() };
                pixel_ptr[1] = std::byte { new_color.extract_green() };
                pixel_ptr[2] = std::byte { new_color.extract_blue() };
                pixel_ptr[3] = std::byte { new_color.extract_alpha() };
            } else {
                canvas::color* pixel_ptr = reinterpret_cast<canvas::color*>(&m_pixels_[(pos.x + pos.y * m_width_) * 4]);
                *pixel_ptr = new_color;
            }
        }

        //// Image Operations
        /// create_mask_from_color
        image& create_mask_from_color(canvas::color test_color, gold::uint8_t alpha_value) noexcept {
            if (m_pixels_.empty())
                return *this;

            // TODO: optimize to process faster
            auto pixels_view = mf_as_mdview_colors_();
            for (auto indices : __mdspan::index_cartesian_product(pixels_view.extents())) {
                canvas::color& old_color = pixels_view[indices];
                if (old_color.to_rgb() == test_color.to_rgb())
                    old_color.set_alpha(alpha_value);
            }

            return *this;
        }

        /// replace_color
        image& replace_color(canvas::color old_color, canvas::color new_color) noexcept {
            if (m_pixels_.empty());

            // TODO: optimize to process faster
            auto pixels_view = mf_as_mdview_colors_();
            for (auto indices : __mdspan::index_cartesian_product(pixels_view.extents())) {
                canvas::color& test_color = pixels_view[indices];
                if (old_color == test_color)
                    test_color = new_color;
            }

            return *this;
        }

        /// to_grayscale
        // TODO: add constexpr
        image& to_grayscale() noexcept {
            if (m_pixels_.empty())
                return *this;

            // TODO: optimize to process faster
            auto pixels_view = mf_as_mdview_colors_();
            for (auto indices : __mdspan::index_cartesian_product(pixels_view.extents())) {
                canvas::color& old_color = pixels_view[indices];
                gold::uint8_t grayscale = (old_color.extract_red() + old_color.extract_green() + old_color.extract_blue()) / 3;
                old_color = canvas::color::from_rgba({
                    grayscale, grayscale, grayscale, old_color.extract_alpha()
                });
            }

            return *this;
        }

        /// horizontal_flip
        image& horizontal_flip() noexcept {
            if (m_pixels_.empty())
                return *this;

            // TODO: optimize to process faster
            // as of now: it takes ~25s to process [very slow]
            // + update: using parallel for -> reduces by 9 seconds
            auto pixels_view = mf_as_mdview_colors_();
            #pragma omp parallel for
            for (std::size_t i = 0; i < m_height_; ++i)
                for (std::size_t j = 0; j < m_width_ / 2; ++j)
                    std::ranges::swap(pixels_view[i, j], pixels_view[i, m_width_ - j - 1]);

            return *this;
        }

        /// vertical_flip
        image& vertical_flip() noexcept {
            if (m_pixels_.empty())
                return *this;

            // TODO: optimize to process faster
            auto pixels_view = mf_as_mdview_colors_();
            #pragma omp parallel for
            for (std::size_t i = 0; i < m_height_ / 2; ++i)
                for (std::size_t j = 0; j < m_width_; ++j)
                    std::ranges::swap(pixels_view[i, j], pixels_view[m_height_ - i - 1, j]);

            return *this;
        }

        /// rotate_left
        image& rotate_left() noexcept;

        /// rotate_right
        image& rotate_right() noexcept;

        /// crop
        image& crop(canvas::region) noexcept;
    };

