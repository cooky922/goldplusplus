      private:
        std::span<std::byte> m_pixels_;
        std::size_t m_width_;
        std::size_t m_height_;

        constexpr auto mf_as_mdview_bytes_() const noexcept {
            using Extents = std::extents<std::size_t, std::dynamic_extent, std::dynamic_extent, 4>;
            return std::mdspan<std::byte, Extents>(m_pixels_.data(), m_height_, m_width_);
