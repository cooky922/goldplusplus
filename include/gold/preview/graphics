            /// operator<=>
            constexpr auto operator<=>(const rectangle_t&) const = default;
        };

        /// color_info_t
        class color_info_t {
          public:
            struct rgb_color_t { std::uint8_t red, green, blue; };
            struct hsl_color_t { float hue, saturation, lightness; };

          private:
            std::uint8_t m_red_, m_green_, m_blue_;

            static constexpr rgb_color_t hex_to_rgb_(const std::uint32_t& hex) {
                return {
                    .red   = std::uint8_t((hex >> 16) & 0xff),
                    .green = std::uint8_t((hex >> 8)  & 0xff),
                    .blue  = std::uint8_t(hex & 0xff)
                };
            }

          public:

            /// constructor - taking RGB in 3 arguments
            constexpr color_info_t(const std::uint8_t& r, const std::uint8_t& g, const std::uint8_t& b)
            : m_red_(r), m_green_(g), m_blue_(b) {}

            /// constructor - taking RGB in range 0.0 - 1.0
            template <std::floating_point T>
            constexpr color_info_t(const T& r, const T& g, const T& b)
            : color_info_t(
                static_cast<std::uint8_t>(r * 255),
                static_cast<std::uint8_t>(g * 255),
                static_cast<std::uint8_t>(b * 255)
            ) {}

            /// constructor - taking RGB
            constexpr color_info_t(const rgb_color_t& rgb)
            : color_info_t(rgb.red, rgb.green, rgb.blue) {}

            /// constructor - taking HEX value
            constexpr color_info_t(const std::uint32_t& hex)
            : color_info_t(hex_to_rgb_(hex)) {}

            /// red
            constexpr auto& red() const noexcept { return m_red_; }

            /// green
            constexpr auto& green() const noexcept { return m_green_; }

            /// blue
            constexpr auto& blue() const noexcept { return m_blue_; }

            /// data
            constexpr auto data() const noexcept {
                return std::array{m_red_, m_green_, m_blue_}.data();
            }

            /// struct_data
            constexpr rgb_color_t struct_data() const noexcept {
                return { .red = m_red_, .green = m_green_, .blue = m_blue_ };
            }

            /// apply_to [ only for 0 - 255 values ]
            template <typename F>
            constexpr void apply_to(F&& f) const noexcept {
                std::forward<F>(f)(m_red_,m_green_, m_blue_);
            }

            /// to_open_unit, name source: https://math.stackexchange.com/questions/231518/name-for-the-real-numbers-between-0-and-1
            constexpr std::array<float, 3> to_open_unit() const noexcept {
                return { m_red_ / 255.0f, m_green_ / 255.0f, m_blue_ / 255.0f };
            }

            //// static methods conversion
            /// from_hex
            static constexpr auto from_hex(const std::uint32_t& hex) noexcept {
                return hex_to_rgb_(hex);
            }

            /// to_hex
            static constexpr std::uint32_t to_hex(const color_info_t& color) noexcept {
                return ((color.m_red_ & 0xff) << 16) + ((color.m_green_ & 0xff) << 8) + (color.m_blue_ & 0xff);
            }

            constexpr auto to_hex() const noexcept {
                return to_hex(*this);
            }

            /// from_hsl [[ incomplete ]]
            /// to_hsl [[ incomplete ]]

            //// transformations
                        /// to_gray_scale
            constexpr color_info_t& to_gray_scale() noexcept {
                const std::uint8_t& new_color_ = (m_red_ + m_green_ + m_blue_) / 3;
                m_red_   = new_color_;
                m_green_ = new_color_;
                m_blue_  = new_color_;
                return *this;
            }

            /// to_invert
            constexpr color_info_t& to_invert() noexcept {
                const auto& new_color_ = hex_to_rgb_(0xffffff - to_hex());
                m_red_  = new_color_.red;
                m_green_ = new_color_.green;
                m_blue_ = new_color_.blue;
                return *this;
            }
        };

