        /// window
        class window_t {
          private:
            struct _partial_construct_t {
                gold::preview::command_line args;
                window_construct_t others;
            };

            struct _full_construct_t {
                gold::preview::command_line args;
                std::string_view title { "Graphics Program" };
                dimension_t<> size { .width = 600, .height = 600 };
                coord_t<> position { .x = 0, .y = 0 };
                rectangle_t<> coord_limit { .left = 0, .right = size.width, .bottom = 0, .top = size.height };
                int display_mode { GLUT_RGBA | GLUT_DEPTH | GLUT_DOUBLE };
            };

            _full_construct_t m_data_;

          public:

            /// constructors
            window_t(const _full_construct_t& arg) noexcept
            : m_data_(arg) {
                glutInit(m_data_.args.m_arg_count_, m_data_.args.m_args_);
                glutInitDisplayMode(m_data_.display_mode);
                glutInitWindowSize(m_data_.size.width, m_data_.size.height);
                glutInitWindowPosition(m_data_.position.x, m_data_.position.y);
                glutCreateWindow(m_data_.title.data());
            }

            window_t(const _partial_construct_t& arg) noexcept
            : window_t({
                .args = arg.args,
                .title = arg.others.title,
                .size = arg.others.size,
                .position = arg.others.position,
                .coord_limit = arg.others.coord_limit,
                .display_mode = arg.others.display_mode
            }) {}

            /// destructor
            ~window_t() {
                glClearColor(1.0f, 1.0f, 1.0f, 1.0f);
                glutMainLoop();
            }

