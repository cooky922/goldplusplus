        /// coord_t
        template <typename T = int>
        struct coord_t {
            /// value_type
            using value_type = T;

            /// data members
            value_type x, y;

            /// copy constructor
            constexpr coord_t& operator=(const coord_t& other) noexcept {
                x = std::move(other.x);
                y = std::move(other.y);
                return *this;
            }

            /// operator==
            constexpr bool operator==(const coord_t&) const = default;

            /// operator<=>
            constexpr auto operator<=>(const coord_t&) const = default;

            /// is_in_range
            constexpr bool is_in_range(const coord_t& a, const coord_t& b) const noexcept {
                return x >= a.x && x <= b.x && y >= a.y && y <= b.y;
            }
        };

        /// dimension_t
        template <typename T = int>
        struct dimension_t {
            /// value_type
            using value_type = T;

            /// data members
            value_type width, height;

            /// operator==
            constexpr bool operator==(const dimension_t&) const = default;

            /// operator<=>
            constexpr auto operator<=>(const dimension_t&) const = default;
        };

        /// rectangle_t
        template <typename T = int>
