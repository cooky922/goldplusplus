        namespace canvas {

            /// set_color_fn
            struct set_color_fn {

                template <typename T>
                void operator()(const T& r, const T& g, const T& b) const noexcept {
                    if constexpr (std::is_same_v<T, std::uint8_t>)
                        glColor3ub(r, g, b);
                    else if constexpr (std::is_same_v<T, std::int16_t>)
                        glColor3s(r, g, b);
                    else if constexpr (std::is_same_v<T, std::uint16_t>)
                        glColor3us(r, g, b);
                    else if constexpr (std::is_same_v<T, std::int32_t>)
                        glColor3i(r, g, b);
                    else if constexpr (std::is_same_v<T, std::uint32_t>)
                        glColor3ui(r, g, b);
                    else if constexpr (std::is_floating_point_v<T>)
                        glColor3f(
                            static_cast<float>(r),
                            static_cast<float>(g),
                            static_cast<float>(b)
                        );
                }

                void operator()(const std::uint32_t& hex) const noexcept {
                    const auto& color_ = color_info_t(hex);
                    glColor3ub(color_.red(), color_.green(), color_.blue());
                }

                void operator()(const color_info_t& color) const noexcept {
                    glColor3ub(color.red(), color.green(), color.blue());
                }
            };

            inline constexpr set_color_fn set_color {};

            /// set_line_width
            inline constexpr auto set_line_width = []<typename T>(const T& width) {
                glLineWidth(float(width));
            };

            /// set_line_stipple
            inline constexpr auto set_line_stipple = [](const std::int32_t& factor, const std::uint16_t& pattern) {
                glLineStipple(factor, pattern);
            };

            /// set_point_size
            inline constexpr auto set_point_size = []<typename T>(const T& size) {
                glPointSize(float(size));
            };

            /// set_vertex_fn
            struct set_vertex_fn {

                template <typename T>
                void operator()(const T& x, const T& y) const noexcept {
                    if constexpr (std::is_same_v<T, double>) {
                        glVertex2d(x, y);
                    } else if constexpr (std::is_same_v<T, float>) {
                        glVertex2f(x, y);
                    } else if constexpr (std::is_same_v<T, int>) {
                        glVertex2i(x, y);
                    } else if constexpr (std::is_same_v<T, float>) {
                        glVertex2s(x, y);
                    }
                }

                template <typename T>
                void operator()(const coord_t<T>& c) const noexcept {
                    (*this)(c.x, c.y);
                }

            };

            /// set_vertex
            inline constexpr set_vertex_fn set_vertex {};

            /// draw_guard
            struct draw_guard {
                draw_guard(const std::uint32_t& mode) {
                    glBegin(mode);
                }
                ~draw_guard() {
                    glEnd();
                }
            };

            /// make_draw_guard
            inline constexpr auto make_draw_guard = []<typename F>(const std::uint32_t& mode, F&& func) {
                draw_guard guard(mode);
                std::forward<F>(func)();
            };

            //// Shapes
            /// draw_style
            enum class draw_style { stroked, filled };

            /// rectangle_fn
            struct rectangle_fn {

                template <typename T>
                void operator()(const T& left,
                                const T& bottom,
                                const T& right,
                                const T& top,
                                draw_style style = draw_style::filled)
                const noexcept {
                    make_draw_guard((style == draw_style::stroked ? GL_LINE_LOOP : GL_POLYGON), [&]{
                        set_vertex(left, bottom);
                        set_vertex(right, bottom);
                        set_vertex(right, top);
                        set_vertex(right, top);
                        set_vertex(left, top);
                    });
                }

                template <typename T>
                void operator()(const coord_t<T>& a,
                                const coord_t<T>& b,
                                draw_style style = draw_style::filled)
                const noexcept {
                    (*this)(a.x, a.y, b.x, b.y, style);
                }

                template <typename T>
                void operator()(const rectangle_t<T>& rect, draw_style style = draw_style::filled) const noexcept {
                    (*this)(rect.left, rect.bottom, rect.right, rect.top, style);
                }

            };

