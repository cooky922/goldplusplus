        /// default_buffer_guard
        struct default_buffer_guard {

            default_buffer_guard(std::uint32_t flag = GL_COLOR_BUFFER_BIT) {
                glClear(flag);
                glLoadIdentity();
            }
            ~default_buffer_guard() {
                glutSwapBuffers();
            }
        };

        /// make_semi_scale
        const auto make_semi_scale = []<typename T>(const rectangle_t<T>& rect, const dimension_t<int>& dim) {
            glViewport(0, 0, dim.width, dim.height);
            glMatrixMode(GL_PROJECTION);
            glLoadIdentity();
            const double& aspect = double(dim.width) / double(dim.height);
            glOrtho(aspect * rect.left, aspect * rect.right, rect.bottom, rect.top, -1.0f, 1.0f);
            glMatrixMode(GL_MODELVIEW);
        };

