        /// is_triangularizable [TODO]

        /// set_applied_each
        // applies the function to each entry and modifies in-place
        // todo: constrain the function
        template <typename F>
        constexpr basic_mat& set_applied_each(F&& f) {
            auto op_span = mf_as_span_();
            for (auto& entry : op_span)
                entry = std::forward<F>(f)(entry);
            return *this;
        }

        /// applied_each
        // returns the copy of the application of each entry
        template <typename F>
        constexpr basic_mat applied_each(F&& f) const {
            // TODO: optimize
            basic_mat new_copy = *this;
            for (auto& entry : new_copy.mf_as_span_())
                entry = std::forward<F>(f)(entry);
            return new_copy;
        }

