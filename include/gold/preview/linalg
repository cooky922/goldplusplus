        /// determinant
        // specialized algorithms for determinants
        constexpr value_type determinant() const noexcept
            requires (basic_mat::is_always_square() || Store == __linalg::storage_mode::store_dynamic)
        {
            if constexpr (static_column_size() == 1 &&
                          static_row_size()    == 1)
                return m_base_[0, 0];
            if constexpr (static_column_size() == 2 &&
                          static_row_size()    == 2)
                return m_base_[0, 0] * m_base_[1, 1]
                     - m_base_[0, 1] * m_base_[1, 0];
            else if constexpr (static_column_size() == 3 &&
                               static_row_size()    == 3)
                return m_base_[0, 0] * m_base_[1, 1] * m_base_[2, 2]
                     + m_base_[0, 1] * m_base_[1, 2] * m_base_[2, 0]
                     + m_base_[0, 2] * m_base_[1, 0] * m_base_[2, 1]
                     - m_base_[0, 2] * m_base_[1, 1] * m_base_[2, 0]
                     - m_base_[0, 1] * m_base_[1, 0] * m_base_[2, 2]
                     - m_base_[0, 0] * m_base_[1, 2] * m_base_[2, 1];
            else
                static_assert(false, "unimplemented, wait...");
        }

        /// trace
        constexpr value_type trace() const noexcept
            requires (basic_mat::is_always_square() || Store == __linalg::storage_mode::store_dynamic)
        {
            // assume: the matrix is square
            value_type result {};
            const auto diagonals = mf_diagonals_();
            for (std::size_t i = 0; i < diagonals.extent(0); ++i)
                result += diagonals[i];
            return result;
        }
