        /// transposed
        // returns a new copy of the transposed matrix
        constexpr basic_mat<T, C, R> transposed() const noexcept
        {
            const auto& self = *this;
            basic_mat<T, C, R> result = [&] {
                if constexpr (Store == __linalg::storage_mode::store_dynamic)
                    return basic_mat<T, C, R> {inplace_dynamic_fill, self.column_size(), self.row_size()};
                else
                    return basic_mat<T, C, R> {};
            }();
            for (std::size_t i = 0; i < self.row_size(); ++i)
                for (std::size_t j = 0; j < self.column_size(); ++j)
                    result[j, i] = self[i, j];
            return result;
        }

